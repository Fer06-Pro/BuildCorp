rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/favorites/{itemId} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['title','savedAt'])
        && request.resource.data.keys().hasAll(['title','savedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.savedAt is timestamp;
      // No updates required for favorites.
    }
    match /users/{uid}/notes/{noteId} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['text','createdAt'])
        && request.resource.data.keys().hasAll(['text','createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt is timestamp;
    }
    // No other database documents are accessible from client apps.
  }
}
